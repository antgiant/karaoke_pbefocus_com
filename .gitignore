.DS_Store
__pycache__/
node_modules/

# The lyrics/stem pipeline (Python scripts + its own local venv/logs/
# generated manifests) and the private song library it produces/consumes
# (the actual audio, its NKJV reference text, and the pipeline docs at
# PBE_2026_2027/AGENTS.md) all stay local/private-host-only until copyright
# clearance -- the whole point of the app's manifest-URL gate is that this
# content never lives in the public code repo. See the public AGENTS.md's
# import line and README.md's "The Library Isn't Public Yet".
/scripts/
/PBE_2026_2027/
/NEW KING JAMES VERSION.json

# A manifest generated for the gate's "Load Local Folder..." option
# (assets/js/offline/local-library.js) contains the same not-yet-cleared
# lyrics/timing content as any other manifest -- see PBE_2026_2027/AGENTS.md.
# It's now written to PBE_2026_2027/manifest.local.json by default, already
# covered by the /PBE_2026_2027/ rule above; this extra rule just covers a
# copy left at the repo root from before that change (or a manual --out).
/manifest.local.json
